ODYSSEY_ENV=local
ODYSSEY_LOG_LEVEL=INFO
ODYSSEY_DATABASE_URL=postgresql+asyncpg://odyssey:odyssey@localhost:5432/odyssey
ODYSSEY_STORAGE_ENDPOINT=http://localhost:9000
ODYSSEY_STORAGE_BUCKET=odyssey-local
ODYSSEY_STORAGE_ACCESS_KEY=odyssey
ODYSSEY_STORAGE_SECRET_KEY=local-development-only
ODYSSEY_MODEL_PROVIDER=deterministic
ODYSSEY_AUTH_MODE=development
ODYSSEY_PROACTIVE_ENABLED=false
ODYSSEY_TELEMETRY_EXPORTER=console

