ODYSSEY_ENV=local
ODYSSEY_LOG_LEVEL=INFO
ODYSSEY_DATABASE_URL=postgresql+asyncpg://odyssey:odyssey@localhost:5432/odyssey
ODYSSEY_STORAGE_ENDPOINT=http://localhost:9000
ODYSSEY_STORAGE_BUCKET=odyssey-local
ODYSSEY_STORAGE_ACCESS_KEY=odyssey
ODYSSEY_STORAGE_SECRET_KEY=local-development-only
ODYSSEY_MODEL_PROVIDER=deterministic
ODYSSEY_AUTH_MODE=development
ODYSSEY_APPLE_CLIENT_ID=
ODYSSEY_APPLE_ISSUER=https://appleid.apple.com
ODYSSEY_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
ODYSSEY_APPLE_BOOTSTRAP_SUBJECT=
ODYSSEY_AUTH_ACCESS_TOKEN_SIGNING_KEY=
ODYSSEY_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
ODYSSEY_AUTH_CLOCK_SKEW_SECONDS=30
ODYSSEY_AUTH_REFRESH_CREDENTIAL_TTL_DAYS=90
ODYSSEY_AUTH_CHALLENGE_TTL_SECONDS=300
ODYSSEY_AUTH_MAX_PENDING_CHALLENGES=1000
ODYSSEY_AUTH_MAX_PENDING_CHALLENGES_PER_DEVICE=5
ODYSSEY_PROACTIVE_ENABLED=false
ODYSSEY_TELEMETRY_EXPORTER=console
ODYSSEY_TELEMETRY_OTLP_ENDPOINT=
ODYSSEY_TELEMETRY_OTLP_HEADERS=
ODYSSEY_TELEMETRY_SAMPLE_RATIO=1.0
ODYSSEY_TELEMETRY_EXPORT_INTERVAL_SECONDS=60
ODYSSEY_TELEMETRY_EXPORT_TIMEOUT_SECONDS=10
ODYSSEY_WORKER_BACKLOG_ALERT_SECONDS=10800
