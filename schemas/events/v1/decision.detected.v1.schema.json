{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "device",
        "system",
        "integration",
        "model"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorRef"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Kind",
          "type": "string"
        },
        "transformation_chain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Transformation Chain",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source_kind",
        "source_id",
        "captured_at",
        "actor"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://schemas.odyssey.local/events/v1/decision.detected.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorRef"
    },
    "aggregate_id": {
      "format": "uuid",
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_type": {
      "const": "decision"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_schema_version": {
      "const": 1
    },
    "event_type": {
      "const": "decision.detected.v1"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "decision_id"
      ],
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_schema_version",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "recorded_at",
    "actor",
    "correlation_id",
    "payload",
    "provenance"
  ],
  "title": "decision.detected.v1",
  "type": "object"
}
