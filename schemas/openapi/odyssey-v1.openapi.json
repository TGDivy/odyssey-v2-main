{
  "components": {
    "schemas": {
      "CaptureCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "broad_location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broad Location"
          },
          "capture_id": {
            "format": "uuid",
            "title": "Capture Id",
            "type": "string"
          },
          "captured_at": {
            "format": "date-time",
            "title": "Captured At",
            "type": "string"
          },
          "content_or_object_ref": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Content Or Object Ref",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "invoking_surface": {
            "title": "Invoking Surface",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/CapturePayloadKind"
          },
          "sensitivity": {
            "$ref": "#/components/schemas/DataClass",
            "default": "private"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "capture_id",
          "event_id",
          "captured_at",
          "kind",
          "content_or_object_ref",
          "device_id",
          "timezone",
          "invoking_surface"
        ],
        "title": "CaptureCreateRequest",
        "type": "object"
      },
      "CaptureCreateResponse": {
        "additionalProperties": false,
        "properties": {
          "capture_id": {
            "format": "uuid",
            "title": "Capture Id",
            "type": "string"
          },
          "created": {
            "title": "Created",
            "type": "boolean"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "interpretation_status": {
            "default": "pending",
            "title": "Interpretation Status",
            "type": "string"
          },
          "ledger_sequence": {
            "title": "Ledger Sequence",
            "type": "integer"
          }
        },
        "required": [
          "capture_id",
          "event_id",
          "ledger_sequence",
          "created"
        ],
        "title": "CaptureCreateResponse",
        "type": "object"
      },
      "CapturePayloadKind": {
        "enum": [
          "text",
          "audio",
          "image_ref",
          "file_ref",
          "structured_quick_action"
        ],
        "title": "CapturePayloadKind",
        "type": "string"
      },
      "DataClass": {
        "enum": [
          "public",
          "private",
          "sensitive",
          "highly_sensitive",
          "operational_secret",
          "derived_sensitive"
        ],
        "title": "DataClass",
        "type": "string"
      },
      "DiagnosticsResponse": {
        "properties": {
          "capabilities": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Capabilities",
            "type": "object"
          },
          "configuration": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Configuration",
            "type": "object"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "configuration",
          "capabilities"
        ],
        "title": "DiagnosticsResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LiveResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "database": {
            "const": "reachable",
            "default": "reachable",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "checked_at"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Private local-first personal navigation API",
    "title": "Odyssey API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "system"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/admin/diagnostics": {
      "get": {
        "operationId": "diagnostics_v1_admin_diagnostics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Diagnostics",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/captures": {
      "post": {
        "operationId": "create_capture_v1_captures_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureCreateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Capture",
        "tags": [
          "captures"
        ]
      }
    }
  }
}
