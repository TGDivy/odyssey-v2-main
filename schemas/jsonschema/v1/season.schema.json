{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "device",
        "system",
        "integration",
        "model"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "AllocationBand": {
      "enum": [
        "minimal",
        "low",
        "moderate",
        "high",
        "dominant"
      ],
      "title": "AllocationBand",
      "type": "string"
    },
    "DataClass": {
      "enum": [
        "public",
        "private",
        "sensitive",
        "highly_sensitive",
        "operational_secret",
        "derived_sensitive"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "DirectionRole": {
      "enum": [
        "primary",
        "foundation",
        "maintenance",
        "exploration",
        "dormant"
      ],
      "title": "DirectionRole",
      "type": "string"
    },
    "EntityMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "last_revised_at": {
          "format": "date-time",
          "title": "Last Revised At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/DataClass"
        },
        "tombstoned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tombstoned At"
        }
      },
      "required": [
        "id",
        "schema_version",
        "created_at",
        "created_by",
        "last_revised_at",
        "revision",
        "sensitivity",
        "provenance_id"
      ],
      "title": "EntityMetadata",
      "type": "object"
    },
    "FrozenOutgoingSeasonSummary": {
      "additionalProperties": false,
      "properties": {
        "effective_interval": {
          "$ref": "#/$defs/TemporalInterval"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "outgoing_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outgoing Content Hash",
          "type": "string"
        },
        "outgoing_season_id": {
          "format": "uuid",
          "title": "Outgoing Season Id",
          "type": "string"
        },
        "outgoing_season_version_id": {
          "format": "uuid",
          "title": "Outgoing Season Version Id",
          "type": "string"
        },
        "plain_language_summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Plain Language Summary",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SeasonStatus"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "outgoing_season_version_id",
        "outgoing_season_id",
        "outgoing_content_hash",
        "frozen_at",
        "title",
        "status",
        "effective_interval",
        "plain_language_summary"
      ],
      "title": "FrozenOutgoingSeasonSummary",
      "type": "object"
    },
    "SeasonCreationSource": {
      "enum": [
        "user",
        "assisted",
        "imported"
      ],
      "title": "SeasonCreationSource",
      "type": "string"
    },
    "SeasonPortfolioItem": {
      "additionalProperties": false,
      "properties": {
        "allocation_band": {
          "$ref": "#/$defs/AllocationBand"
        },
        "direction_id": {
          "format": "uuid",
          "title": "Direction Id",
          "type": "string"
        },
        "minimum_viable_commitment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Viable Commitment"
        },
        "review_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Date"
        },
        "role": {
          "$ref": "#/$defs/DirectionRole"
        },
        "sacrifice_limit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sacrifice Limit"
        },
        "success_signals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Success Signals",
          "type": "array"
        }
      },
      "required": [
        "direction_id",
        "role",
        "allocation_band"
      ],
      "title": "SeasonPortfolioItem",
      "type": "object"
    },
    "SeasonRetrospective": {
      "additionalProperties": false,
      "properties": {
        "achievements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Achievements",
          "type": "array"
        },
        "beliefs_invalidated": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Beliefs Invalidated",
          "type": "array"
        },
        "beliefs_strengthened": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Beliefs Strengthened",
          "type": "array"
        },
        "data_and_model_quality_notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Data And Model Quality Notes",
          "type": "array"
        },
        "decisions_that_changed_direction": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Decisions That Changed Direction",
          "type": "array"
        },
        "disappointments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Disappointments",
          "type": "array"
        },
        "overview": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Overview",
          "type": "string"
        },
        "people_and_experiences_that_mattered": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "People And Experiences That Mattered",
          "type": "array"
        },
        "practices_to_carry_forward": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Practices To Carry Forward",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SeasonRetrospectiveStatus",
          "default": "draft"
        },
        "unfinished_commitment_decisions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unfinished Commitment Decisions",
          "type": "array"
        }
      },
      "required": [
        "overview"
      ],
      "title": "SeasonRetrospective",
      "type": "object"
    },
    "SeasonRetrospectiveStatus": {
      "enum": [
        "draft",
        "accepted",
        "skipped"
      ],
      "title": "SeasonRetrospectiveStatus",
      "type": "string"
    },
    "SeasonStatus": {
      "enum": [
        "draft",
        "calibration",
        "active",
        "transitioning",
        "complete",
        "abandoned"
      ],
      "title": "SeasonStatus",
      "type": "string"
    },
    "TemporalInterval": {
      "additionalProperties": false,
      "properties": {
        "all_day_semantics": {
          "default": false,
          "title": "All Day Semantics",
          "type": "boolean"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "end_precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "start_precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "timezone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone Id"
        }
      },
      "title": "TemporalInterval",
      "type": "object"
    },
    "TemporalPrecision": {
      "enum": [
        "exact",
        "minute",
        "hour",
        "day",
        "month",
        "approximate",
        "unknown"
      ],
      "title": "TemporalPrecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/season.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "charter_revision_id": {
      "format": "uuid",
      "title": "Charter Revision Id",
      "type": "string"
    },
    "constraints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "created_from": {
      "$ref": "#/$defs/SeasonCreationSource"
    },
    "effective_interval": {
      "$ref": "#/$defs/TemporalInterval"
    },
    "explicit_non_goals": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Explicit Non Goals",
      "type": "array"
    },
    "failure_guardrails": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Failure Guardrails",
      "type": "array"
    },
    "good_week_description": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Good Week Description",
      "type": "string"
    },
    "known_tradeoffs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Known Tradeoffs",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/EntityMetadata"
    },
    "opportunity_budgets": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Opportunity Budgets",
      "type": "array"
    },
    "outgoing_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrozenOutgoingSeasonSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "portfolio_items": {
      "items": {
        "$ref": "#/$defs/SeasonPortfolioItem"
      },
      "title": "Portfolio Items",
      "type": "array"
    },
    "primary_override_explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Override Explanation"
    },
    "progress_signals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Progress Signals",
      "type": "array"
    },
    "protected_experiences": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Protected Experiences",
      "type": "array"
    },
    "rationale": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "retrospective": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeasonRetrospective"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_cadence": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Review Cadence",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SeasonStatus"
    },
    "supersedes_season_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Season Id"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "transition_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transition Notes"
    },
    "transition_triggers": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Transition Triggers",
      "type": "array"
    },
    "triggering_context": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Triggering Context",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "charter_revision_id",
    "title",
    "effective_interval",
    "status",
    "created_from",
    "rationale",
    "portfolio_items",
    "explicit_non_goals",
    "good_week_description",
    "transition_triggers",
    "review_cadence"
  ],
  "title": "Season",
  "type": "object"
}
