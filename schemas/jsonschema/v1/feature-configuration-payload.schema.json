{
  "$defs": {
    "FeatureFlagKey": {
      "enum": [
        "product_telemetry.capture_question",
        "product_telemetry.tomorrow_map_question",
        "product_telemetry.weekly_review",
        "intervention.proactive_notifications"
      ],
      "title": "FeatureFlagKey",
      "type": "string"
    },
    "FeatureFlagRule": {
      "additionalProperties": false,
      "properties": {
        "assignment_salt": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Assignment Salt",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/FeatureFlagKey"
        },
        "rollout_basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Rollout Basis Points",
          "type": "integer"
        },
        "variant": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9_.-]+$",
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "key",
        "variant",
        "rollout_basis_points",
        "assignment_salt"
      ],
      "title": "FeatureFlagRule",
      "type": "object"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/feature-configuration-payload.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "maxLength": 255,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]+[A-Za-z0-9]$",
      "title": "Audience",
      "type": "string"
    },
    "configuration_id": {
      "format": "uuid",
      "title": "Configuration Id",
      "type": "string"
    },
    "environment": {
      "maxLength": 30,
      "minLength": 1,
      "pattern": "^(local|development|staging|production|test)$",
      "title": "Environment",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/FeatureFlagRule"
      },
      "maxItems": 50,
      "title": "Flags",
      "type": "array"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "configuration_id",
    "version",
    "environment",
    "audience",
    "issued_at",
    "not_before",
    "expires_at",
    "flags"
  ],
  "title": "FeatureConfigurationPayload",
  "type": "object"
}
