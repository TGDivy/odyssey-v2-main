{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "device",
        "system",
        "integration",
        "model"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "DataClass": {
      "enum": [
        "public",
        "private",
        "sensitive",
        "highly_sensitive",
        "operational_secret",
        "derived_sensitive"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "EntityMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "last_revised_at": {
          "format": "date-time",
          "title": "Last Revised At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/DataClass"
        },
        "tombstoned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tombstoned At"
        }
      },
      "required": [
        "id",
        "schema_version",
        "created_at",
        "created_by",
        "last_revised_at",
        "revision",
        "sensitivity",
        "provenance_id"
      ],
      "title": "EntityMetadata",
      "type": "object"
    },
    "EpisodeStatus": {
      "enum": [
        "candidate",
        "accepted",
        "edited",
        "rejected"
      ],
      "title": "EpisodeStatus",
      "type": "string"
    },
    "TemporalInterval": {
      "additionalProperties": false,
      "properties": {
        "all_day_semantics": {
          "default": false,
          "title": "All Day Semantics",
          "type": "boolean"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "end_precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "start_precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "timezone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone Id"
        }
      },
      "title": "TemporalInterval",
      "type": "object"
    },
    "TemporalPrecision": {
      "enum": [
        "exact",
        "minute",
        "hour",
        "day",
        "month",
        "approximate",
        "unknown"
      ],
      "title": "TemporalPrecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/episode.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "media_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Media Refs",
      "type": "array"
    },
    "member_event_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Member Event Ids",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/EntityMetadata"
    },
    "person_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Person Ids",
      "type": "array"
    },
    "place_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Place Ids",
      "type": "array"
    },
    "significance_assertions": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Significance Assertions",
      "type": "array"
    },
    "source_linked_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Linked Summary"
    },
    "status": {
      "$ref": "#/$defs/EpisodeStatus"
    },
    "temporal_interval": {
      "$ref": "#/$defs/TemporalInterval"
    },
    "title_candidate": {
      "title": "Title Candidate",
      "type": "string"
    }
  },
  "required": [
    "metadata",
    "title_candidate",
    "temporal_interval",
    "member_event_ids",
    "status"
  ],
  "title": "Episode",
  "type": "object"
}
