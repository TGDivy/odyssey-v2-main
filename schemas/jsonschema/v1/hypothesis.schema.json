{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "device",
        "system",
        "integration",
        "model"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "DataClass": {
      "enum": [
        "public",
        "private",
        "sensitive",
        "highly_sensitive",
        "operational_secret",
        "derived_sensitive"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "EntityMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "last_revised_at": {
          "format": "date-time",
          "title": "Last Revised At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/DataClass"
        },
        "tombstoned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tombstoned At"
        }
      },
      "required": [
        "id",
        "schema_version",
        "created_at",
        "created_by",
        "last_revised_at",
        "revision",
        "sensitivity",
        "provenance_id"
      ],
      "title": "EntityMetadata",
      "type": "object"
    },
    "HypothesisStatus": {
      "enum": [
        "exploratory",
        "review",
        "experiment_eligible",
        "rejected",
        "supported",
        "inconclusive",
        "superseded"
      ],
      "title": "HypothesisStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/hypothesis.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counterevidence": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Counterevidence",
      "type": "array"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/EntityMetadata"
    },
    "plausible_confounders": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Plausible Confounders",
      "type": "array"
    },
    "prior_plausibility": {
      "title": "Prior Plausibility",
      "type": "string"
    },
    "proposed_causal_direction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Causal Direction"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/HypothesisStatus"
    },
    "supporting_observations": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Supporting Observations",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "statement",
    "domain",
    "prior_plausibility",
    "status"
  ],
  "title": "Hypothesis",
  "type": "object"
}
