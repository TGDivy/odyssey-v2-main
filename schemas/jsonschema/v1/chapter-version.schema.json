{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "device",
        "system",
        "integration",
        "model"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "DataClass": {
      "enum": [
        "public",
        "private",
        "sensitive",
        "highly_sensitive",
        "operational_secret",
        "derived_sensitive"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "EntityMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "last_revised_at": {
          "format": "date-time",
          "title": "Last Revised At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/DataClass"
        },
        "tombstoned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tombstoned At"
        }
      },
      "required": [
        "id",
        "schema_version",
        "created_at",
        "created_by",
        "last_revised_at",
        "revision",
        "sensitivity",
        "provenance_id"
      ],
      "title": "EntityMetadata",
      "type": "object"
    },
    "SourceAnnotation": {
      "additionalProperties": false,
      "properties": {
        "sentence_index": {
          "title": "Sentence Index",
          "type": "integer"
        },
        "source_record_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Record Ids",
          "type": "array"
        }
      },
      "required": [
        "sentence_index",
        "source_record_ids"
      ],
      "title": "SourceAnnotation",
      "type": "object"
    },
    "TemporalInterval": {
      "additionalProperties": false,
      "properties": {
        "all_day_semantics": {
          "default": false,
          "title": "All Day Semantics",
          "type": "boolean"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "end_precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "start_precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "timezone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone Id"
        }
      },
      "title": "TemporalInterval",
      "type": "object"
    },
    "TemporalPrecision": {
      "enum": [
        "exact",
        "minute",
        "hour",
        "day",
        "month",
        "approximate",
        "unknown"
      ],
      "title": "TemporalPrecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/chapter-version.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted At"
    },
    "alternative_interpretations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternative Interpretations",
      "type": "array"
    },
    "chapter_id": {
      "format": "uuid",
      "title": "Chapter Id",
      "type": "string"
    },
    "episode_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Episode Ids",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/EntityMetadata"
    },
    "narrative": {
      "title": "Narrative",
      "type": "string"
    },
    "source_annotations": {
      "items": {
        "$ref": "#/$defs/SourceAnnotation"
      },
      "title": "Source Annotations",
      "type": "array"
    },
    "temporal_interval": {
      "$ref": "#/$defs/TemporalInterval"
    },
    "themes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Themes",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "metadata",
    "chapter_id",
    "title",
    "temporal_interval",
    "episode_ids",
    "narrative",
    "source_annotations"
  ],
  "title": "ChapterVersion",
  "type": "object"
}
