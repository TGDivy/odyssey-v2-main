{
  "$defs": {
    "ProductEventName": {
      "enum": [
        "capture.workflow_started.v1",
        "capture.workflow_finished.v1",
        "capture.feedback_recorded.v1",
        "tomorrow_map.availability_evaluated.v1",
        "tomorrow_map.viewed.v1",
        "tomorrow_map.session_finished.v1",
        "tomorrow_map.feedback_recorded.v1",
        "tomorrow_map.plan_deviation_recorded.v1"
      ],
      "title": "ProductEventName",
      "type": "string"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/product-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "app_build": {
      "maxLength": 100,
      "minLength": 1,
      "title": "App Build",
      "type": "string"
    },
    "causal_parent_event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causal Parent Event Id"
    },
    "context_version": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Context Version",
      "type": "string"
    },
    "device_id": {
      "format": "uuid",
      "title": "Device Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_name": {
      "$ref": "#/$defs/ProductEventName"
    },
    "feature_flag_assignments": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 50,
      "title": "Feature Flag Assignments",
      "type": "object"
    },
    "local_only_flag": {
      "default": true,
      "title": "Local Only Flag",
      "type": "boolean"
    },
    "object_id_pseudonymous": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Id Pseudonymous"
    },
    "object_type": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Type"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "properties_typed": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          }
        ]
      },
      "maxProperties": 30,
      "title": "Properties Typed",
      "type": "object"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "surface": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9_.-]+$",
      "title": "Surface",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "received_at",
    "device_id",
    "app_build",
    "surface",
    "event_name",
    "context_version"
  ],
  "title": "ProductEvent",
  "type": "object"
}
