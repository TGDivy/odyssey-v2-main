{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "device",
        "system",
        "integration",
        "model"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "DataClass": {
      "enum": [
        "public",
        "private",
        "sensitive",
        "highly_sensitive",
        "operational_secret",
        "derived_sensitive"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "EntityMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "last_revised_at": {
          "format": "date-time",
          "title": "Last Revised At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/DataClass"
        },
        "tombstoned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tombstoned At"
        }
      },
      "required": [
        "id",
        "schema_version",
        "created_at",
        "created_by",
        "last_revised_at",
        "revision",
        "sensitivity",
        "provenance_id"
      ],
      "title": "EntityMetadata",
      "type": "object"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "cached_tokens": {
          "default": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "estimated_cost_minor_units": {
          "default": 0,
          "title": "Estimated Cost Minor Units",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "ModelUsage",
      "type": "object"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/model-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "title": "Capability",
      "type": "string"
    },
    "capability_version": {
      "title": "Capability Version",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "fallback_chain": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fallback Chain",
      "type": "array"
    },
    "input_data_classes": {
      "items": {
        "$ref": "#/$defs/DataClass"
      },
      "title": "Input Data Classes",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/EntityMetadata"
    },
    "model_snapshot": {
      "title": "Model Snapshot",
      "type": "string"
    },
    "output_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Ref"
    },
    "output_schema_version": {
      "title": "Output Schema Version",
      "type": "string"
    },
    "prompt_hash": {
      "title": "Prompt Hash",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "retrieval_pack_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Pack Id"
    },
    "route_policy": {
      "title": "Route Policy",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tool_call_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Tool Call Ids",
      "type": "array"
    },
    "usage_and_cost": {
      "$ref": "#/$defs/ModelUsage"
    },
    "user_feedback_refs": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "User Feedback Refs",
      "type": "array"
    },
    "validation_result": {
      "title": "Validation Result",
      "type": "string"
    }
  },
  "required": [
    "metadata",
    "capability",
    "capability_version",
    "provider",
    "model_snapshot",
    "prompt_hash",
    "output_schema_version",
    "input_data_classes",
    "route_policy",
    "started_at",
    "usage_and_cost",
    "validation_result"
  ],
  "title": "ModelRun",
  "type": "object"
}
