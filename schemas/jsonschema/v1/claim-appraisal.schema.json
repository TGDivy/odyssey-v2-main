{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "device",
        "system",
        "integration",
        "model"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "AppraisalBand": {
      "enum": [
        "low_concern",
        "some_concern",
        "high_concern",
        "unknown"
      ],
      "title": "AppraisalBand",
      "type": "string"
    },
    "ConfidenceBand": {
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "very_high"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "DataClass": {
      "enum": [
        "public",
        "private",
        "sensitive",
        "highly_sensitive",
        "operational_secret",
        "derived_sensitive"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "EntityMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "last_revised_at": {
          "format": "date-time",
          "title": "Last Revised At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/DataClass"
        },
        "tombstoned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tombstoned At"
        }
      },
      "required": [
        "id",
        "schema_version",
        "created_at",
        "created_by",
        "last_revised_at",
        "revision",
        "sensitivity",
        "provenance_id"
      ],
      "title": "EntityMetadata",
      "type": "object"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/claim-appraisal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability_to_user": {
      "title": "Applicability To User",
      "type": "string"
    },
    "appraised_by": {
      "title": "Appraised By",
      "type": "string"
    },
    "claim_id": {
      "format": "uuid",
      "title": "Claim Id",
      "type": "string"
    },
    "imprecision": {
      "$ref": "#/$defs/AppraisalBand"
    },
    "inconsistency": {
      "$ref": "#/$defs/AppraisalBand"
    },
    "indirectness": {
      "$ref": "#/$defs/AppraisalBand"
    },
    "metadata": {
      "$ref": "#/$defs/EntityMetadata"
    },
    "overall_confidence": {
      "$ref": "#/$defs/ConfidenceBand"
    },
    "publication_bias_or_reporting_concern": {
      "$ref": "#/$defs/AppraisalBand"
    },
    "review_due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Due At"
    },
    "risk_of_bias": {
      "$ref": "#/$defs/AppraisalBand"
    },
    "study_design_quality": {
      "$ref": "#/$defs/AppraisalBand"
    }
  },
  "required": [
    "metadata",
    "claim_id",
    "study_design_quality",
    "risk_of_bias",
    "inconsistency",
    "indirectness",
    "imprecision",
    "publication_bias_or_reporting_concern",
    "applicability_to_user",
    "overall_confidence",
    "appraised_by"
  ],
  "title": "ClaimAppraisal",
  "type": "object"
}
