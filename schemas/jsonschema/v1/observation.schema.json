{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "device",
        "system",
        "integration",
        "model"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "Applicability": {
      "enum": [
        "direct",
        "partial",
        "indirect",
        "unknown"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "ConfidenceBand": {
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "very_high"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "DataClass": {
      "enum": [
        "public",
        "private",
        "sensitive",
        "highly_sensitive",
        "operational_secret",
        "derived_sensitive"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "EntityMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "last_revised_at": {
          "format": "date-time",
          "title": "Last Revised At",
          "type": "string"
        },
        "provenance_id": {
          "format": "uuid",
          "title": "Provenance Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sensitivity": {
          "$ref": "#/$defs/DataClass"
        },
        "tombstoned_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tombstoned At"
        }
      },
      "required": [
        "id",
        "schema_version",
        "created_at",
        "created_by",
        "last_revised_at",
        "revision",
        "sensitivity",
        "provenance_id"
      ],
      "title": "EntityMetadata",
      "type": "object"
    },
    "EpistemicKind": {
      "enum": [
        "observed",
        "user_stated",
        "externally_asserted",
        "inferred",
        "hypothesized",
        "experimentally_supported",
        "accepted_interpretation",
        "retracted"
      ],
      "title": "EpistemicKind",
      "type": "string"
    },
    "EpistemicState": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Applicability",
          "default": "unknown"
        },
        "confidence_band": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceBand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "kind": {
          "$ref": "#/$defs/EpistemicKind"
        },
        "last_evaluated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Evaluated At"
        },
        "numeric_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numeric Confidence"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EpistemicState",
      "type": "object"
    },
    "ObservationCorrection": {
      "additionalProperties": false,
      "properties": {
        "corrected_at": {
          "format": "date-time",
          "title": "Corrected At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "replacement_observation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Observation Id"
        }
      },
      "required": [
        "id",
        "corrected_at",
        "reason"
      ],
      "title": "ObservationCorrection",
      "type": "object"
    },
    "TemporalInterval": {
      "additionalProperties": false,
      "properties": {
        "all_day_semantics": {
          "default": false,
          "title": "All Day Semantics",
          "type": "boolean"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "end_precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "start_precision": {
          "$ref": "#/$defs/TemporalPrecision",
          "default": "unknown"
        },
        "timezone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone Id"
        }
      },
      "title": "TemporalInterval",
      "type": "object"
    },
    "TemporalPrecision": {
      "enum": [
        "exact",
        "minute",
        "hour",
        "day",
        "month",
        "approximate",
        "unknown"
      ],
      "title": "TemporalPrecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.odyssey.local/v1/observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corrections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ObservationCorrection"
      },
      "title": "Corrections",
      "type": "array"
    },
    "epistemic_state": {
      "$ref": "#/$defs/EpistemicState"
    },
    "metadata": {
      "$ref": "#/$defs/EntityMetadata"
    },
    "observation_type": {
      "title": "Observation Type",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "occurred_interval": {
      "$ref": "#/$defs/TemporalInterval"
    },
    "quality": {
      "title": "Quality",
      "type": "string"
    },
    "source_record_id": {
      "format": "uuid",
      "title": "Source Record Id",
      "type": "string"
    },
    "subject_id": {
      "format": "uuid",
      "title": "Subject Id",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "value": {
      "title": "Value"
    }
  },
  "required": [
    "metadata",
    "subject_id",
    "observation_type",
    "value",
    "occurred_interval",
    "observed_at",
    "source_record_id",
    "quality",
    "epistemic_state"
  ],
  "title": "Observation",
  "type": "object"
}
